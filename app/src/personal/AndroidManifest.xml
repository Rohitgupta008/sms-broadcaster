<?xml version="1.0" encoding="utf-8"?>
<!-- Personal (GitHub) edition only: automatic SMS sending from the SIM and in-app updates.
     The Play edition gets none of these, so it requests no SMS permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Only used to list SIM cards on dual-SIM phones. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- In-app updates: check GitHub for a newer build and install it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets the update-help note open the Play Store (Android 11+ package visibility). -->
    <queries>
        <package android:name="com.android.vending" />
    </queries>

    <application>
        <receiver
            android:name=".sms.SmsResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
